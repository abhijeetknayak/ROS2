<?xml version="1.0"?>
<sdf version="1.9">
  <world name="robotics_lab">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.35 0.35 0.38 1</ambient>
      <background>0.08 0.10 0.14 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>0.8</intensity>
      <direction>-0.4 0.2 -0.9</direction>
      <diffuse>0.85 0.85 0.80 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
    </light>
    <light type="point" name="lab_light_west">
      <pose>-3 0 3.8 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>8</intensity>
      <diffuse>0.80 0.88 1.00 1</diffuse>
      <attenuation><range>10</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light type="point" name="lab_light_east">
      <pose>3 0 3.8 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>8</intensity>
      <diffuse>1.00 0.90 0.75 1</diffuse>
      <attenuation><range>10</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry><plane><normal>0 0 1</normal><size>14 11</size></plane></geometry>
        </collision>
        <visual name="floor_visual">
          <geometry><plane><normal>0 0 1</normal><size>14 11</size></plane></geometry>
          <material><ambient>0.18 0.20 0.23 1</ambient><diffuse>0.28 0.30 0.34 1</diffuse><specular>0.15 0.15 0.15 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Coloured floor zones make the camera view easy to interpret. -->
    <model name="start_zone"><static>true</static><pose>-5 -3.4 0.006 0 0 0</pose><link name="link"><visual name="mat"><geometry><box><size>1.8 1.4 0.01</size></box></geometry><material><ambient>0.12 0.35 0.70 1</ambient><diffuse>0.12 0.35 0.70 1</diffuse></material></visual></link></model>
    <model name="assembly_zone"><static>true</static><pose>-3 2.8 0.006 0 0 0</pose><link name="link"><visual name="mat"><geometry><box><size>3.0 2.0 0.01</size></box></geometry><material><ambient>0.13 0.42 0.47 1</ambient><diffuse>0.13 0.42 0.47 1</diffuse></material></visual></link></model>
    <model name="storage_zone"><static>true</static><pose>3.8 2.8 0.006 0 0 0</pose><link name="link"><visual name="mat"><geometry><box><size>3.2 2.0 0.01</size></box></geometry><material><ambient>0.65 0.32 0.08 1</ambient><diffuse>0.65 0.32 0.08 1</diffuse></material></visual></link></model>
    <model name="charge_zone"><static>true</static><pose>4.8 -3.2 0.006 0 0 0</pose><link name="link"><visual name="mat"><geometry><box><size>2.2 1.8 0.01</size></box></geometry><material><ambient>0.08 0.50 0.23 1</ambient><diffuse>0.08 0.50 0.23 1</diffuse></material></visual></link></model>

    <!-- Outer walls. -->
    <model name="wall_north"><static>true</static><pose>0 5.15 1.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>13.4 0.25 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>13.4 0.25 2.5</size></box></geometry><material><ambient>0.55 0.58 0.64 1</ambient><diffuse>0.55 0.58 0.64 1</diffuse></material></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -5.15 1.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>13.4 0.25 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>13.4 0.25 2.5</size></box></geometry><material><ambient>0.55 0.58 0.64 1</ambient><diffuse>0.55 0.58 0.64 1</diffuse></material></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-6.6 0 1.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.25 10.0 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.25 10.0 2.5</size></box></geometry><material><ambient>0.48 0.52 0.60 1</ambient><diffuse>0.48 0.52 0.60 1</diffuse></material></visual></link></model>
    <model name="wall_east"><static>true</static><pose>6.6 0 1.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.25 10.0 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.25 10.0 2.5</size></box></geometry><material><ambient>0.48 0.52 0.60 1</ambient><diffuse>0.48 0.52 0.60 1</diffuse></material></visual></link></model>

    <!-- Internal partitions leave several wide doorways. -->
    <model name="partition_west"><static>true</static><pose>-3.9 0.4 0.9 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4.2 0.18 1.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>4.2 0.18 1.8</size></box></geometry><material><ambient>0.35 0.38 0.44 1</ambient><diffuse>0.35 0.38 0.44 1</diffuse></material></visual></link></model>
    <model name="partition_east"><static>true</static><pose>4.5 0.4 0.9 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>3.8 0.18 1.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>3.8 0.18 1.8</size></box></geometry><material><ambient>0.35 0.38 0.44 1</ambient><diffuse>0.35 0.38 0.44 1</diffuse></material></visual></link></model>
    <model name="partition_vertical"><static>true</static><pose>0.8 3.15 0.9 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.18 3.7 1.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.18 3.7 1.8</size></box></geometry><material><ambient>0.35 0.38 0.44 1</ambient><diffuse>0.35 0.38 0.44 1</diffuse></material></visual></link></model>

    <!-- Blue gateway landmark. -->
    <model name="blue_gateway">
      <static>true</static><pose>-1.4 -1.0 0 0 0 0</pose>
      <link name="link">
        <collision name="left_col_c"><pose>0 0.85 0.8 0 0 0</pose><geometry><box><size>0.22 0.22 1.6</size></box></geometry></collision>
        <collision name="right_col_c"><pose>0 -0.85 0.8 0 0 0</pose><geometry><box><size>0.22 0.22 1.6</size></box></geometry></collision>
        <collision name="top_c"><pose>0 0 1.55 0 0 0</pose><geometry><box><size>0.22 1.9 0.22</size></box></geometry></collision>
        <visual name="left_col"><pose>0 0.85 0.8 0 0 0</pose><geometry><box><size>0.22 0.22 1.6</size></box></geometry><material><ambient>0.05 0.30 0.85 1</ambient><diffuse>0.05 0.30 0.85 1</diffuse></material></visual>
        <visual name="right_col"><pose>0 -0.85 0.8 0 0 0</pose><geometry><box><size>0.22 0.22 1.6</size></box></geometry><material><ambient>0.05 0.30 0.85 1</ambient><diffuse>0.05 0.30 0.85 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 1.55 0 0 0</pose><geometry><box><size>0.22 1.9 0.22</size></box></geometry><material><ambient>0.05 0.30 0.85 1</ambient><diffuse>0.05 0.30 0.85 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Assembly tables. -->
    <model name="assembly_table_1"><static>true</static><pose>-3.8 2.7 0 0 0 0</pose><link name="link"><collision name="top_c"><pose>0 0 0.78 0 0 0</pose><geometry><box><size>1.5 0.75 0.12</size></box></geometry></collision><visual name="top"><pose>0 0 0.78 0 0 0</pose><geometry><box><size>1.5 0.75 0.12</size></box></geometry><material><ambient>0.65 0.68 0.72 1</ambient><diffuse>0.65 0.68 0.72 1</diffuse></material></visual><collision name="leg1_c"><pose>0.6 0.25 0.38 0 0 0</pose><geometry><box><size>0.1 0.1 0.75</size></box></geometry></collision><collision name="leg2_c"><pose>0.6 -0.25 0.38 0 0 0</pose><geometry><box><size>0.1 0.1 0.75</size></box></geometry></collision><collision name="leg3_c"><pose>-0.6 0.25 0.38 0 0 0</pose><geometry><box><size>0.1 0.1 0.75</size></box></geometry></collision><collision name="leg4_c"><pose>-0.6 -0.25 0.38 0 0 0</pose><geometry><box><size>0.1 0.1 0.75</size></box></geometry></collision><visual name="legs"><pose>0 0 0.38 0 0 0</pose><geometry><box><size>1.25 0.5 0.06</size></box></geometry><material><ambient>0.18 0.20 0.23 1</ambient><diffuse>0.18 0.20 0.23 1</diffuse></material></visual></link></model>
    <model name="assembly_robot_arm_display"><static>true</static><pose>-3.8 2.7 1.0 0 0 0</pose><link name="link"><visual name="pedestal"><geometry><cylinder><radius>0.24</radius><length>0.32</length></cylinder></geometry><material><ambient>0.10 0.16 0.20 1</ambient><diffuse>0.10 0.16 0.20 1</diffuse></material></visual><visual name="arm"><pose>0 0 0.45 0 0.4 0</pose><geometry><box><size>0.16 0.16 0.75</size></box></geometry><material><ambient>0.90 0.70 0.08 1</ambient><diffuse>0.90 0.70 0.08 1</diffuse></material></visual><visual name="tool"><pose>0.15 0 0.82 0 0 0</pose><geometry><sphere><radius>0.13</radius></sphere></geometry><material><ambient>0.90 0.18 0.10 1</ambient><diffuse>0.90 0.18 0.10 1</diffuse></material></visual></link></model>

    <!-- Orange storage crates. -->
    <model name="crate_stack"><static>true</static><pose>3.9 2.9 0 0 0 0</pose><link name="link"><collision name="c1"><pose>-0.55 0 0.35 0 0 0</pose><geometry><box><size>0.9 0.9 0.7</size></box></geometry></collision><collision name="c2"><pose>0.55 0 0.35 0 0 0</pose><geometry><box><size>0.9 0.9 0.7</size></box></geometry></collision><collision name="c3"><pose>0 0 1.05 0 0 0</pose><geometry><box><size>0.9 0.9 0.7</size></box></geometry></collision><visual name="v1"><pose>-0.55 0 0.35 0 0 0</pose><geometry><box><size>0.9 0.9 0.7</size></box></geometry><material><ambient>0.92 0.35 0.05 1</ambient><diffuse>0.92 0.35 0.05 1</diffuse></material></visual><visual name="v2"><pose>0.55 0 0.35 0 0 0</pose><geometry><box><size>0.9 0.9 0.7</size></box></geometry><material><ambient>0.82 0.24 0.03 1</ambient><diffuse>0.82 0.24 0.03 1</diffuse></material></visual><visual name="v3"><pose>0 0 1.05 0 0 0</pose><geometry><box><size>0.9 0.9 0.7</size></box></geometry><material><ambient>1.00 0.48 0.08 1</ambient><diffuse>1.00 0.48 0.08 1</diffuse></material></visual></link></model>

    <!-- Green charging station. -->
    <model name="charging_station"><static>true</static><pose>5.5 -3.3 0 0 0 1.5708</pose><link name="link"><collision name="body_c"><pose>0 0 0.65 0 0 0</pose><geometry><box><size>0.25 1.3 1.3</size></box></geometry></collision><visual name="body"><pose>0 0 0.65 0 0 0</pose><geometry><box><size>0.25 1.3 1.3</size></box></geometry><material><ambient>0.03 0.42 0.16 1</ambient><diffuse>0.03 0.42 0.16 1</diffuse></material></visual><visual name="screen"><pose>-0.14 0 0.85 0 0 0</pose><geometry><box><size>0.02 0.65 0.40</size></box></geometry><material><ambient>0.10 0.90 0.45 1</ambient><diffuse>0.10 0.90 0.45 1</diffuse><emissive>0.05 0.45 0.20 1</emissive></material></visual></link></model>

    <!-- Purple science exhibit and navigation obstacles. -->
    <model name="science_exhibit"><static>true</static><pose>0.6 -3.1 0 0 0 0</pose><link name="link"><collision name="base_c"><pose>0 0 0.35 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>0.7</length></cylinder></geometry></collision><visual name="base"><pose>0 0 0.35 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>0.7</length></cylinder></geometry><material><ambient>0.30 0.12 0.45 1</ambient><diffuse>0.30 0.12 0.45 1</diffuse></material></visual><visual name="orb"><pose>0 0 1.0 0 0 0</pose><geometry><sphere><radius>0.32</radius></sphere></geometry><material><ambient>0.65 0.20 0.95 1</ambient><diffuse>0.65 0.20 0.95 1</diffuse><emissive>0.15 0.03 0.25 1</emissive></material></visual></link></model>
    <model name="yellow_pillar"><static>true</static><pose>2.2 -1.6 0.65 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.25</radius><length>1.3</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.25</radius><length>1.3</length></cylinder></geometry><material><ambient>0.95 0.78 0.05 1</ambient><diffuse>0.95 0.78 0.05 1</diffuse></material></visual></link></model>
    <model name="red_pillar"><static>true</static><pose>2.2 -3.6 0.65 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.25</radius><length>1.3</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.25</radius><length>1.3</length></cylinder></geometry><material><ambient>0.85 0.08 0.06 1</ambient><diffuse>0.85 0.08 0.06 1</diffuse></material></visual></link></model>

    <!-- Differential-drive robot with forward RGB camera. -->
    <model name="inspection_bot" canonical_link="base_link">
      <pose>-5.0 -3.4 0 0 0 0</pose>

      <link name="base_link">
        <pose>0 0 0.16 0 0 0</pose>
        <inertial><mass>8.0</mass><inertia><ixx>0.08</ixx><iyy>0.14</iyy><izz>0.18</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.46 0.30 0.16</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.46 0.30 0.16</size></box></geometry><material><ambient>0.03 0.46 0.55 1</ambient><diffuse>0.03 0.46 0.55 1</diffuse><specular>0.25 0.25 0.25 1</specular></material></visual>
        <visual name="top_cover"><pose>-0.03 0 0.11 0 0 0</pose><geometry><box><size>0.30 0.24 0.07</size></box></geometry><material><ambient>0.78 0.82 0.86 1</ambient><diffuse>0.78 0.82 0.86 1</diffuse></material></visual>
        <visual name="front_bumper"><pose>0.25 0 -0.02 0 0 0</pose><geometry><box><size>0.04 0.34 0.09</size></box></geometry><material><ambient>0.95 0.68 0.04 1</ambient><diffuse>0.95 0.68 0.04 1</diffuse></material></visual>
      </link>

      <link name="left_wheel">
        <pose relative_to="base_link">-0.02 0.18 -0.06 -1.5708 0 0</pose>
        <inertial><mass>0.8</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.05</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.05</length></cylinder></geometry><material><ambient>0.03 0.03 0.04 1</ambient><diffuse>0.03 0.03 0.04 1</diffuse></material></visual>
      </link>
      <link name="right_wheel">
        <pose relative_to="base_link">-0.02 -0.18 -0.06 -1.5708 0 0</pose>
        <inertial><mass>0.8</mass><inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.05</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.05</length></cylinder></geometry><material><ambient>0.03 0.03 0.04 1</ambient><diffuse>0.03 0.03 0.04 1</diffuse></material></visual>
      </link>

      <link name="front_caster">
        <pose relative_to="base_link">0.17 0 -0.12 0 0 0</pose>
        <inertial><mass>0.15</mass><inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.04</radius></sphere></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><sphere><radius>0.04</radius></sphere></geometry><material><ambient>0.15 0.15 0.17 1</ambient><diffuse>0.15 0.15 0.17 1</diffuse></material></visual>
      </link>
      <link name="rear_caster">
        <pose relative_to="base_link">-0.17 0 -0.12 0 0 0</pose>
        <inertial><mass>0.15</mass><inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.04</radius></sphere></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><sphere><radius>0.04</radius></sphere></geometry><material><ambient>0.15 0.15 0.17 1</ambient><diffuse>0.15 0.15 0.17 1</diffuse></material></visual>
      </link>

      <link name="camera_link">
        <pose relative_to="base_link">0.20 0 0.18 0 0 0</pose>
        <inertial><mass>0.12</mass><inertia><ixx>0.0003</ixx><iyy>0.0003</iyy><izz>0.0003</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="camera_collision"><geometry><box><size>0.08 0.10 0.07</size></box></geometry></collision>
        <visual name="camera_body"><geometry><box><size>0.08 0.10 0.07</size></box></geometry><material><ambient>0.06 0.06 0.07 1</ambient><diffuse>0.06 0.06 0.07 1</diffuse></material></visual>
        <visual name="camera_lens"><pose>0.045 0 0 0 1.5708 0</pose><geometry><cylinder><radius>0.025</radius><length>0.025</length></cylinder></geometry><material><ambient>0.05 0.15 0.35 1</ambient><diffuse>0.05 0.15 0.35 1</diffuse><emissive>0.01 0.03 0.08 1</emissive></material></visual>
        <sensor name="front_rgb_camera" type="camera">
          <pose>0.05 0 0 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>20</update_rate>
          <visualize>true</visualize>
          <topic>/camera/image_raw</topic>
          <gz_frame_id>camera_link</gz_frame_id>
          <camera name="front_camera">
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>360</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>50</far></clip>
            <camera_info_topic>/camera/camera_info</camera_info_topic>
          </camera>
        </sensor>

        <sensor name="lidar" type="gpu_lidar">
          <pose>0.2 0 0.3 0 0 0</pose>

          <topic>scan</topic>
          <update_rate>10</update_rate>

          <ray>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>

            <range>
              <min>0.10</min>
              <max>10.0</max>
              <resolution>0.01</resolution>
            </range>
          </ray>

          <always_on>true</always_on>
          <visualize>true</visualize>
        </sensor>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <pose relative_to="left_wheel"/>
        <parent>base_link</parent><child>left_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1.0e16</lower><upper>1.0e16</upper><effort>20</effort><velocity>20</velocity></limit></axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <pose relative_to="right_wheel"/>
        <parent>base_link</parent><child>right_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1.0e16</lower><upper>1.0e16</upper><effort>20</effort><velocity>20</velocity></limit></axis>
      </joint>
      <joint name="front_caster_joint" type="ball"><parent>base_link</parent><child>front_caster</child></joint>
      <joint name="rear_caster_joint" type="ball"><parent>base_link</parent><child>rear_caster</child></joint>
      <joint name="camera_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.36</wheel_separation>
        <wheel_radius>0.10</wheel_radius>
        <odom_publish_frequency>30</odom_publish_frequency>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
      </plugin>
    </model>
  </world>
</sdf>
